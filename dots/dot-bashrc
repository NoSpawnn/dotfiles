# If not running interactively, don't do anything
[[ $- != *i* ]] && return

### Utility functions ###

_command_exists() {
	command -v "$1" &>/dev/null
}

_flatpak_installed() {
    flatpak list --app --columns application | grep "$1" &>/dev/null
}

# Source other definitions
if [ -f /etc/bashrc ]; then source /etc/bashrc; fi

export HISTCONTROL=ignoreboth:erasedups

PATH="$PATH:$HOME/.local/bin"
export PATH

if [ -z "$SSH_CONNECTION" ]; then
    if _flatpak_installed "com.bitwarden.desktop" && [ -e "$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock" ]; then
        export SSH_AUTH_SOCK="$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"
    elif _command_exists bitwarden-desktop && [ -e "$HOME/.bitwarden-ssh-agent.sock" ]; then
        export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
    fi
fi

if _command_exists fzf; then
	eval "$(fzf --bash)"
	if _command_exists fd; then export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow'; fi
fi

### Aliases ###

alias ls="ls -a --color=auto"
alias grep="grep --color=auto"

if _command_exists lazygit; then alias lg="lazygit"; fi
if _command_exists zoxide; then
    eval "$(zoxide init bash --cmd cd)"
    alias zi="__zoxide_zi"
fi
if _command_exists eza; then
	alias ls="eza -hl --icons=auto"
	alias ll="eza -hla --icons=auto"
    # Suppressing the error code when no matches are found, there's probably a more robust way to do this
	alias l.="eza -hl -d .* --icons=auto 2> /dev/null || true"
fi

### Keybinds ###

bind '"\e[3~": delete-char'
# Ctrl+Arrow keys
bind '"\e[1;5D": backward-word'
bind '"\e[1;5C": forward-word'
# Ctrl+Backspace
bind '"\C-h": backward-kill-word'
# Ctrl+Delete
bind '"\e[3;5~": kill-word'

### Prompt ###
export PS1="\\A \\w \\n> "
export PS2="... "

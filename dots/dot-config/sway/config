#
# Variables
#
    set {
        # Mod4 = Logo key, Mod1 = Alt
        $mod Mod4

        $left  h
        $down  j
        $up    k
        $right l

        $term         foot
        $runner       fuzzel
        $lock         swaylock --color 000000
        $file_manager thunar
    }

    include /etc/sway/config-vars.d/*
#
# Output configuration
#
    seat * {
        xcursor_theme Twilight-cursors 26
        hide_cursor when-typing enable
    }

    exec "swayidle                                 \
            -w timeout 300                         \
            'swaylock -f -c 000000' timeout 600 '  \
            swaymsg \"output * power off\"'        \
            resume 'swaymsg \"output * power on\"' \
            before-sleep 'swaylock -f -c 000000'"
    #
    # xd90
    #
        output 'California Institute of Technology 0x130F Unknown' {
            scale 1.5
        }
    #
    # spawnpoint
    #
        output 'Dell Inc. DELL S2721DGF C626R83' {
            mode 2560x1440@165Hz
            # put at 0,0 as a reference for the other monitors
            position 0 0
        }

        output 'YMK EM160TP-A 0x00000001' {
            mode 2880x1800@120Hz
            position 580 -900
        }
    #
    # Theming
    #
        # prefer dark mode everywhere - requires adwaita-dark to be available
        # TODO: auto light/dark mode should be trivial for a lot of apps with this...
        exec_always dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'"
        exec_always dconf write /org/gnome/desktop/interface/gtk-theme "'Adwaita-dark'"
#
# Input configuration
#
    input type:touchpad {
        accel_profile flat
        natural_scroll enabled
    }

    input type:pointer {
        accel_profile flat
    }

    input type:keyboard {
        repeat_rate 35
        repeat_delay 200
        xkb_layout "gb"
        xkb_options caps:swapescape
    }

    input 5824:10203:Go60_Keyboard {
        # not on a split lol
        xkb_options ""
        xkb_layout "us"
    }

    # RK96
    input 9610:164:SINO_WEALTH_Gaming_KB {
        xkb_layout "us"
    }
#
# Key bindings
#
    floating_modifier $mod normal

    # Misc
    bindsym {
        $mod+Shift+q kill
        $mod+Shift+c reload

        $mod+Return  exec $term
        $mod+o       exec $file_manager
        $mod+d       exec $runner
        $mod+Escape  exec $lock
        $mod+Shift+e exec swaynag -t warning -m 'Really exit?' -B 'Yes, exit sway' 'swaymsg exit'
    }

    # Focus movement
    bindsym {
        $mod+$left  focus left
        $mod+$down  focus down
        $mod+$up    focus up
        $mod+$right focus right
        $mod+Left   focus left
        $mod+Down   focus down
        $mod+Up     focus up
        $mod+Right  focus right
    }

    # Container movement
    bindsym {
        $mod+Shift+$left  move left
        $mod+Shift+$down  move down
        $mod+Shift+$up    move up
        $mod+Shift+$right move right
        $mod+Shift+Left   move left
        $mod+Shift+Down   move down
        $mod+Shift+Up     move up
        $mod+Shift+Right  move right
    }

    # Workspace stuff
    bindsym {
        $mod+1 workspace number 1
        $mod+2 workspace number 2
        $mod+3 workspace number 3
        $mod+4 workspace number 4
        $mod+5 workspace number 5
        $mod+6 workspace number 6
        $mod+7 workspace number 7
        $mod+8 workspace number 8
        $mod+9 workspace number 9
        $mod+0 workspace number 10
        $mod+Shift+1 move container to workspace number 1
        $mod+Shift+2 move container to workspace number 2
        $mod+Shift+3 move container to workspace number 3
        $mod+Shift+4 move container to workspace number 4
        $mod+Shift+5 move container to workspace number 5
        $mod+Shift+6 move container to workspace number 6
        $mod+Shift+7 move container to workspace number 7
        $mod+Shift+8 move container to workspace number 8
        $mod+Shift+9 move container to workspace number 9
        $mod+Shift+0 move container to workspace number 10
    }
#
# Layout stuff:
#
    bindsym {
        # You can "split" the current object of your focus with
        # $mod+b or $mod+v, for horizontal and vertical splits
        # respectively.
        $mod+b splith
        $mod+v splitv

        # Switch the current container between different layout styles
        $mod+s layout stacking
        $mod+w layout tabbed
        $mod+e layout toggle split

        # Make the current focus fullscreen
        $mod+f fullscreen

        # Toggle the current focus between tiling and floating mode
        $mod+Shift+space floating toggle

        # Swap focus between the tiling area and the floating area
        $mod+space focus mode_toggle

        # Move focus to the parent container
        $mod+a focus parent
    }
#
# Window rules:
#
    set {
        $center       move position center
        $float        floating enable
        $float_center $float; $center; resize set width 75ppt height 90ppt
    }

    for_window {
        [window_role="^(pop-up|bubble|dialog)$"] $float

        [title="(?:Open|Save) (?:File|Folder|As)"] $float_center
        [title="Picture-in-Picture"] $float_center; sticky enable; inhibit_idle open
        [app_id="org.pulseaudio.pavucontrol"] $float_center
        [app_id="bitwarden"] $float_center

        [class="^steam" title="^notificationtoasts"] floating enable; move position 100%-w-10 100%-h-10
        [class="steam_app.*"] inhibit_idle focus; border none
        [instance="steam_app.*"] inhibit_idle focus; border none

        [shell="xwayland"] title_format "%title [XWayland]"
    }
#
# Scratchpad:
#
    bindsym {
        $mod+Shift+minus move scratchpad
        $mod+minus       scratchpad show
    }
#
# Resizing containers:
#
    set $resize_step 10px
    bindsym $mod+r mode "resize"
    mode "resize" {
        # left will shrink the containers width
        # right will grow the containers width
        # up will shrink the containers height
        # down will grow the containers height
        bindsym {
            $up    resize shrink height $resize_step
            $down  resize grow   height $resize_step
            $left  resize shrink width  $resize_step
            $right resize grow   width  $resize_step

            Up    resize shrink height $resize_step
            Down  resize grow   height $resize_step
            Left  resize shrink width  $resize_step
            Right resize grow   width  $resize_step

            Return mode "default"
            Escape mode "default"
        }
    }
#
# Utilities:
#
    # Volume
    bindsym {
        --locked XF86AudioMute        exec pactl set-sink-mute     \@DEFAULT_SINK@ toggle
        --locked XF86AudioLowerVolume exec pactl set-sink-volume   \@DEFAULT_SINK@ -5%
        --locked XF86AudioRaiseVolume exec pactl set-sink-volume   \@DEFAULT_SINK@ +5%
        --locked XF86AudioMicMute     exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
    }

    # Brightness
    bindsym {
        --locked XF86MonBrightnessDown exec brightnessctl set 5%-
        --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
    }

    bindsym Print exec --no-startup-id slurp | grim -g - | wl-copy
#
# Status Bar:
#
    set {
        $bar_color_statusline #ffffff
        $bar_color_background #323232
        $bar_color_inactive_workspace #32323200 #32323200 #5c5c5c
    }

    bar {
        position bottom

        status_command while ~/.config/sway/scripts/status.sh; do sleep 5; done
        tray_output *

        font 0xProto Nerd Font 14
        colors {
            statusline $bar_color_statusline
            background $bar_color_background
            inactive_workspace $bar_color_inactive_workspace
        }
    }

include /etc/sway/config.d/*

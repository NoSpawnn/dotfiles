[ -d "$HOME/bin" ] && PATH="$HOME/bin:$PATH"
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ -d "$HOME/.nix-profile/bin" ] && PATH="$HOME/.nix-profile/bin:$PATH"

XDG_DATA_DIRS="/usr/share:$XDG_DATA_DIRS"
[ -d "$HOME/.nix-profile/share" ] && XDG_DATA_DIRS="$HOME/.nix-profile/share:$XDG_DATA_DIRS"
[ -d "$HOME/.local/share/flatpak/exports/share" ] && XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:$XDG_DATA_DIRS"
[ -d "/var/lib/flatpak/exports/share" ] && XDG_DATA_DIRS="/var/lib/flatpak/exports/share:$XDG_DATA_DIRS"

[ -f "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ] && source "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"

[ -d "$HOME/.local/share/icons" ] && XCURSOR_PATH="$HOME/.local/share/icons:$XCURSOR_PATH"

export PATH
export XDG_DATA_DIRS

if [ -n "$BASH_VERSION" ]; then
    [ -f "$HOME/.bashrc" ] && source "$HOME/.bashrc"
fi


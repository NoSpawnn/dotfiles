# If not running interactively, don't do anything
[[ $- != *i* ]] && return

### Utility functions ###

_command_exists() {
    command -v "$1" &> /dev/null
}

### Aliases ###
setopt COMPLETE_ALIASES

alias ls="ls -a --color=auto"
alias grep="grep --color=auto"

_command_exists lazygit && alias lg="lazygit"
_command_exists zellij && alias zj="zellij"
if _command_exists eza; then
    alias ls="eza -hl --icons=auto"
    alias ll="eza -hla --icons=auto"
    alias l.="eza -hl -d .* --icons=auto 2> /dev/null || true"
fi
if _command_exists nvim; then
    alias v="nvim"
    export EDITOR="nvim"
fi

### Binds ###
# List functions with `print -l ${(ok)functions}`
bindkey "^[[3~" delete-char
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word
bindkey "^H" backward-delete-word
bindkey "^[[3;5~" delete-word
bindkey "^I" menu-complete
bindkey "^[[Z" reverse-menu-complete
bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward

### History ###
HISTFILE=~/.zhistory
HISTSIZE=10000
SAVEHIST=10000
setopt histignorealldups
setopt SHARE_HISTORY

### Case-insensitive path-completion ###
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select

autoload bashcompinit && bashcompinit
autoload -Uz +X compinit && compinit

### Integrations ###
if [ -z "$SSH_CONNECTION" ]; then
    local sockpath="$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"
    [ -e "$sockpath" ] && export SSH_AUTH_SOCK="$sockpath"
fi

if _command_exists fzf; then
    eval "$(fzf --zsh)"
    _command_exists fd && export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow'
fi

if _command_exists zoxide; then
    eval "$(zoxide init zsh --cmd cd)"
    alias zi="__zoxide_zi"
fi

_command_exists devenv && eval "$(devenv hook zsh)"

_command_exists starship && eval "$(starship init zsh)"

